# ==============================================================================
# AutoTube Studio — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials or a filled `.env` file to version control.
# 2. Private server secrets below are ignored by the Android Secrets Gradle
#    Plugin (see `app/build.gradle.kts` `secrets.ignoreList`) so they are NEVER
#    compiled into the Android APK.
# 3. Configure backend secrets in Render Dashboard -> Environment Variables
#    (and locally in `backend/.env` using `backend/.env.example`).
# ==============================================================================

# --- Public Client & Shared Config ---
BACKEND_API_URL=https://your-autotube-api.onrender.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Backend-Only Secrets (Render Web Service, Worker & Scheduler ONLY) ---
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars-32-byte-aes-256-key
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# YOUTUBE_OAUTH_REDIRECT_URI=https://your-autotube-api.onrender.com/api/youtube/oauth/callback

# --- Optional Platform Default Provider Keys (Backend ONLY; users use BYOK) ---
# GOOGLE_GEMINI_API_KEY=optional-platform-default-gemini-key
# PEXELS_API_KEY=optional-platform-default-pexels-key
# PIXABAY_API_KEY=optional-platform-default-pixabay-key
# ELEVENLABS_API_KEY=optional-platform-default-elevenlabs-key
# FCM_CONFIGURATION=optional-base64-firebase-service-account-json
